# Device specific properties
import /system/etc/properties/${ro.boot.product.hardware.sku}.prop

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Zygote
zygote.critical_window.minute=10

# Infinity-X
ro.infinity.soc=Mediatek Helio G88
ro.infinity.battery=5000 mAh
ro.infinity.display=1080 x 2400, 90 Hz
ro.infinity.camera=50MP+8MP+2MP+2MP

set_prop(hal_audio_default, vendor_mtk_audiohal_prop)
hal_client_domain(hal_audio_default, hal_power)
allow hal_audio_default property_socket:sock_file write;
allow hal_audio_default sysfs:file { read open getattr };
allow hal_audio_default sysfs_boot_info:file { read open getattr };
allow hal_audio_default persist_data_file:dir search;
allow hal_audio_default ccci_aud_device:chr_file rw_file_perms;
r_dir_file(hal_audio_default, mtk_audiohal_data_file)
